% Clean academic Beamer theme (navy + red accent), 16:9.
\mode<presentation>

\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,decorations.pathreplacing}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.17}

% ---------- Colours ----------
\definecolor{navy}{HTML}{1F3A5F}
\definecolor{navylight}{HTML}{E9EEF5}
\definecolor{accent}{HTML}{B03A2E}
\definecolor{good}{HTML}{2E7D32}
\definecolor{softgray}{HTML}{6B7280}
\definecolor{steel}{HTML}{C9D3E6}
\definecolor{navymid}{HTML}{3A5683}

\setbeamercolor{normal text}{fg=black!85,bg=white}
\setbeamercolor{structure}{fg=navy}
\setbeamercolor{alerted text}{fg=accent}
\setbeamercolor{frametitle}{fg=white,bg=navy}
\setbeamercolor{foot left}{fg=white,bg=navy}
\setbeamercolor{foot mid}{fg=navy,bg=steel}
\setbeamercolor{foot right}{fg=navy,bg=gray!20}
\setbeamercolor{item projected}{fg=white,bg=navy}

\setbeamercolor{block title}{fg=white,bg=navy}
\setbeamercolor{block body}{fg=black!85,bg=navylight}
\setbeamercolor{block title alerted}{fg=white,bg=accent}
\setbeamercolor{block body alerted}{fg=black!85,bg=accent!8}
\setbeamercolor{block title example}{fg=white,bg=good}
\setbeamercolor{block body example}{fg=black!85,bg=good!8}

% ---------- Fonts ----------
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{block title}{size=\small,series=\bfseries}

% ---------- Templates ----------
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{itemize item}{\textcolor{accent}{\scriptsize$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\textcolor{navy}{\tiny$\blacksquare$}}
\setbeamertemplate{enumerate items}[circle]
\setbeamersize{text margin left=1.0cm,text margin right=1.0cm}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=1.9em,dp=0.75em,leftskip=1.0cm,rightskip=0.6cm]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle
  \end{beamercolorbox}%
  \nointerlineskip
  \hbox{\color{accent}\rule{\paperwidth}{1.2pt}}%
  \vskip0.2em
}

% Clickable section bar: each name links to the first slide of that section.
\setbeamercolor{section in head/foot}{fg=navy,bg=steel}
\setbeamerfont{section in head/foot}{size=\fontsize{7.2}{8.5}\selectfont}
\setbeamertemplate{section in head/foot}{\textcolor{navy}{\bfseries\insertsectionhead}}
\setbeamertemplate{section in head/foot shaded}{\textcolor{navymid!80}{\insertsectionhead}}
\setbeamertemplate{headline}{%
  \leavevmode
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.3ex,dp=0.9ex]{section in head/foot}%
    \usebeamerfont{section in head/foot}%
    \insertsectionnavigationhorizontal{\paperwidth}{\hskip0pt plus1fill}{\hskip0pt plus1fill}%
  \end{beamercolorbox}%
}

\setbeamertemplate{footline}{%
  \leavevmode\hbox{%
    \begin{beamercolorbox}[wd=.25\paperwidth,ht=2.4ex,dp=1ex,center]{foot left}%
      \usebeamerfont{footline}\bfseries\insertshorttitle
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.65\paperwidth,ht=2.4ex,dp=1ex,center]{foot mid}%
      \usebeamerfont{footline}\insertfootmiddle
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.10\paperwidth,ht=2.4ex,dp=1ex,center]{foot right}%
      \usebeamerfont{footline}\insertframenumber\,/\,\inserttotalframenumber
    \end{beamercolorbox}}%
}

% Text for the middle of the footline (set with \footmiddle{...}; defaults to the author)
\def\insertfootmiddle{\insertshortauthor}
\newcommand{\footmiddle}[1]{\def\insertfootmiddle{#1}}

% ---------- Helpers ----------
\newcommand{\hl}[1]{\textcolor{accent}{\textbf{#1}}}
\newcommand{\ok}[1]{\textcolor{good}{\textbf{#1}}}
\newcommand{\src}[1]{{\par\centering\tiny\color{softgray}#1\par}}

% \card[height]{colour}{title}{body}: coloured box filling the current column width
\newcommand{\card}[4][2.6cm]{%
  \tikz\node[draw=#2, fill=#2!6, rounded corners=4pt, line width=0.8pt, inner sep=6pt]
    {\parbox[t][#1][t]{\dimexpr\linewidth-14pt\relax}{\raggedright
      {\color{#2}\bfseries #3}\par\vspace{3pt}\small #4}};%
}

\tikzset{
  box/.style    ={draw=navy, fill=navylight, rounded corners=3pt, line width=0.8pt,
                  align=center, font=\footnotesize, inner sep=4pt},
  boxacc/.style ={box, draw=accent, fill=accent!8},
  boxgood/.style={box, draw=good, fill=good!8},
  boxgray/.style={box, draw=gray!60, fill=gray!10},
  arr/.style    ={-{Stealth[length=2.2mm]}, line width=0.9pt, draw=navy!85},
  tok/.style    ={draw=gray!70, fill=gray!15, minimum size=5mm, inner sep=0pt, font=\scriptsize},
  ptok/.style   ={tok, draw=accent, fill=accent!25},
  ctok/.style   ={tok, draw=good, fill=good!30},
}

\pgfplotsset{
  cleanplot/.style={
    axis line style={gray!60}, tick style={gray!60},
    ymajorgrids, grid style={gray!20},
    tick label style={font=\scriptsize}, label style={font=\scriptsize},
    legend style={font=\scriptsize, draw=none, fill=none},
    legend cell align=left,
  },
}

\mode<all>
